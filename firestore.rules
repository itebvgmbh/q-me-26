rules_version = '2';

// Firestore-Sicherheitsregeln für Dranzeit (Firebase-Projekt qmedata-7c79e).
// Fassung: 2026-10-23 (bei jeder Änderung neu setzen; daran erkennt der Block in deploy/README.md, was eingespielt ist)
//
// Eingespielt wird von Hand in der Firebase-Konsole: Anleitung und Rücknahme in deploy/README.md,
// Abschnitt „Firestore-Regeln“. Geprüft im Emulator: dev/regeln (npm test), läuft auch auf GitHub bei jedem Push.
//
// Die Regeln gelten nur für den Browser (App und Testskripte mit dem öffentlichen Web-Schlüssel). Das Backend
// arbeitet mit dem Admin SDK (Dienstkonto) und ist von ihnen nicht betroffen: Stripe-Webhook, Gründerplatz,
// Betreiber-Bereich, Benachrichtigungen und Aufräumen dürfen weiter alles.
//
// Grundsatz (Stand 23.10.2026, wer was liest und schreibt: dev/regeln/README.md):
//  - Lesen bleibt offen, wo Buchen und Nummer ziehen ohne Anmeldung es brauchen: Läden, Personen, Leistungen,
//    Pausen, Termine (freie Plätze, Schlange, Wartezimmer-Bildschirm), Belegung und Tagesnummern.
//  - Schreiben darf nur, wer zum Laden gehört: der Inhaber (shops.owner) oder eine Person im Team. Team heißt:
//    Vermerk shops/{shopId}/members/{uid}, den das Backend beim Annehmen der Einladung setzt.
//  - Ohne Anmeldung und als Kunde nur, was die App dort tut: eine Nummer ziehen oder buchen, die eigene absagen,
//    eine Nummer ohne Konto ins eigene Konto übernehmen – und dabei Belegung und Tagesnummern fortschreiben.
//  - Kundenliste nur für Inhaber und Team, Profile (users) nur für das eigene Konto.
//  - Die Tarif-Felder am Laden setzt nur das Backend. Sammlungen, die nur das Backend braucht, sind zu.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(shop) {
      return signedIn() && shop.owner == request.auth.uid;
    }

    function docPath(coll, id) {
      return /databases/$(database)/documents/$(coll)/$(id);
    }

    // Inhaber des Ladens mit dieser ID (fehlt der Laden, gilt das als nein)
    function ownsShop(shopId) {
      return signedIn() && shopId is string && get(docPath('shops', shopId)).data.owner == request.auth.uid;
    }

    // Person im Team: Vermerk, den das Backend beim Annehmen der Einladung setzt (backend/app/libs/team.py)
    function isMember(shopId) {
      return signedIn() && shopId is string
        && exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid));
    }

    function isTeam(shopId) {
      return ownsShop(shopId) || isMember(shopId);
    }

    // Die Person gehört zu diesem Laden. Freie Plätze werden je Person gesucht (staffId), deshalb hängt niemand
    // Termine, Pausen oder Belegung an eine Person eines anderen Ladens.
    function staffInShop(staffId, shopId) {
      return staffId is string && get(docPath('staff', staffId)).data.shopId == shopId;
    }

    // Laden nicht gesperrt (Betreiber-Bereich): für Kunden nichts mehr buchbar
    function notSuspended(shopId) {
      return get(docPath('shops', shopId)).data.get('suspended', null) == null;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Tarif-Felder am Laden. Wer sie schreiben kann, nutzt bezahlte Tarife umsonst oder hebt eine Sperre auf.
    //   plan, billing         Abo (Stripe-Webhook)
    //   trialEndsAt           Ende der Testphase (Anlegen, Gründerplatz, Betreiber)
    //   founder, founderSince Gründerplatz (/billing/claim-founder, Betreiber)
    //   grant                 Freischaltung ohne Stripe (Betreiber)
    //   suspended             Laden gesperrt (Betreiber)
    function planFields() {
      return ['plan', 'billing', 'trialEndsAt', 'founder', 'founderSince', 'grant', 'suspended'];
    }

    // Beim Anlegen darf ein Laden Tarif-Felder nur so mitbringen, dass sein Inhaber nichts davon hat:
    // Gratis, höchstens die normale Testphase von 30 Tagen (ein Tag Spielraum für falsch gehende Uhren),
    // auch eine schon abgelaufene, oder gleich gesperrt. Die App setzt plan 'gratis' und trialEndsAt = jetzt + 30 Tage
    // (utils/plans.ts, newShopPlanFields); Testskripte legen so Läden mit beendeter Testphase oder gesperrt an.
    // createdAt zählt mit: Ohne trialEndsAt läuft die Testphase 30 Tage ab createdAt (plans.ts/plans.py, trialEnd).
    function harmlessNewShop(shop) {
      return !shop.keys().hasAny(['billing', 'founder', 'founderSince', 'grant'])
        && (!('plan' in shop) || shop.plan == 'gratis')
        && (!('trialEndsAt' in shop)
            || (shop.trialEndsAt is timestamp && shop.trialEndsAt <= request.time + duration.value(31, 'd')))
        && (!('createdAt' in shop)
            || (shop.createdAt is timestamp && shop.createdAt <= request.time + duration.value(1, 'd')))
        && (!('suspended' in shop) || shop.suspended == null
            || (shop.suspended is map && shop.suspended.keys().hasOnly(['at'])));
    }

    function deletedShop(shopId) {
      return /databases/$(database)/documents/deleted_shops/$(shopId);
    }

    // Läden: lesen darf jeder (Läden finden, Buchen, Nummer ziehen, Wartezimmer-Bildschirm – alles ohne Anmeldung).
    match /shops/{shopId} {
      allow read: if true;

      // Anlegen nur für sich selbst (Einrichtungsassistent, utils/shop-setup.ts) und nicht unter der ID eines
      // gelöschten Ladens – sonst brächte Löschen und Neuanlegen eine frische Testphase und höbe eine Sperre auf.
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && harmlessNewShop(request.resource.data)
        && !exists(deletedShop(shopId));

      // Ändern nur der Inhaber (Mein Laden, Assistent, Startklar-Merker) und nie Tarif-Felder, Inhaber oder
      // Anlegedatum. Unverändert mitgeschickte Werte stören nicht: Es zählt nur, was sich wirklich ändert.
      // Das Team ändert den Laden nicht (Startklar merkt sich dann im Browser).
      allow update: if isOwner(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(planFields().concat(['owner', 'createdAt']));

      // Löschen nur der Inhaber und nur zusammen mit dem Vermerk in deleted_shops (ein Schritt, writeBatch oder
      // commit). Die App selbst löscht keine Läden; das tun nur Testskripte und das Backend (Betreiber-Bereich).
      allow delete: if isOwner(resource.data)
        && existsAfter(deletedShop(shopId));

      // Team-Vermerk shops/{shopId}/members/{uid} ({staffId, at}): setzt das Backend beim Annehmen der Einladung.
      // Der Inhaber nimmt ihn beim Deaktivieren einer Person weg und beim Zurückholen wieder auf – nur für eine Person
      // dieses Ladens, die schon mit genau diesem Konto verbunden ist. Lesen braucht ihn niemand (die Regeln sehen ihn).
      match /members/{memberUid} {
        allow create: if isOwner(get(docPath('shops', shopId)).data)
          && request.resource.data.keys().hasOnly(['staffId', 'at'])
          && get(docPath('staff', request.resource.data.staffId)).data.shopId == shopId
          && get(docPath('staff', request.resource.data.staffId)).data.userId == memberUid;
        allow delete: if isOwner(get(docPath('shops', shopId)).data);
      }
    }

    // Vermerk „diese Laden-ID ist verbraucht“. Nur anlegen, im selben Schritt, in dem der eigene Laden gelöscht wird;
    // ändern, löschen oder lesen im Browser nicht (die Regel oben sieht ihn trotzdem).
    match /deleted_shops/{shopId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'deletedAt'])
        && request.resource.data.owner == request.auth.uid
        && get(/databases/$(database)/documents/shops/$(shopId)).data.owner == request.auth.uid
        && !existsAfter(/databases/$(database)/documents/shops/$(shopId));
    }

    // ------------------------------------------------------------------------------------------------------------
    // Termine. Lesen für alle: Nummer ziehen und Buchen ohne Anmeldung suchen freie Plätze in den Terminen der Person
    // (staffId + Tag), /nummer/<id> und der Wartezimmer-Bildschirm zeigen die Schlange.
    // ------------------------------------------------------------------------------------------------------------

    // Was nur Laden und Backend an einen Termin schreiben (Aufrufen, Fertig, Nachricht an den Kunden …)
    function shopOnlyFields() {
      return ['calledAt', 'lastCalledAt', 'completedAt', 'noShow', 'notifiedCalledAt', 'notifyEmail',
              'customerNotice', 'customerNoticeAt', 'customerNoticePreviousStart'];
    }

    // Nummer ohne Konto (Nummer ziehen ohne Anmeldung, QueueBookingService)
    function anonymousTicket(d) {
      return d.get('isAnonymous', false) == true && !('customerId' in d)
        && d.type == 'queue' && d.status == 'scheduled';
    }

    // Nummer oder Termin für das eigene Konto (Nummer ziehen, Termin buchen)
    function ownBooking(d) {
      return signedIn() && d.get('customerId', '') == request.auth.uid && d.get('isAnonymous', false) == false
        && d.type in ['queue', 'booked'] && d.status == 'scheduled';
    }

    // Absagen: nur der Status, von wartend auf abgesagt (Nummernseite ohne Anmeldung, Meine Termine)
    function cancelOnly() {
      return changed().hasOnly(['status', 'updatedAt'])
        && resource.data.status == 'scheduled' && request.resource.data.status == 'cancelled';
    }

    // Nummer ohne Konto nach dem Anmelden ins eigene Konto übernehmen (AnonymousBookingLinker)
    function claimAnonymous() {
      return signedIn() && resource.data.get('isAnonymous', false) == true && !('customerId' in resource.data)
        && changed().hasOnly(['customerId', 'customerName', 'isAnonymous', 'updatedAt'])
        && request.resource.data.customerId == request.auth.uid && request.resource.data.isAnonymous == false;
    }

    match /appointments/{id} {
      allow read: if true;

      allow create: if request.resource.data.shopId is string && (
          isTeam(request.resource.data.shopId)
          || ((anonymousTicket(request.resource.data) || ownBooking(request.resource.data))
              && !request.resource.data.keys().hasAny(shopOnlyFields())
              && staffInShop(request.resource.data.staffId, request.resource.data.shopId)
              && notSuspended(request.resource.data.shopId)));

      allow update: if request.resource.data.shopId == resource.data.shopId && (
          isTeam(resource.data.shopId)
          || (cancelOnly() && (resource.data.get('isAnonymous', false) == true
                               || (signedIn() && resource.data.get('customerId', '') == request.auth.uid)))
          || claimAnonymous());

      // Die App löscht keine Termine (Absagen ist ein Status); Testskripte räumen ihren Laden auf
      allow delete: if ownsShop(resource.data.shopId);
    }

    // Belegung je Person und Tag (schedules/{staffId}_{Tag}): wird in jeder Buchung, Absage und Änderung in derselben
    // Transaktion mitgeschrieben, auch ohne Anmeldung. Nur in der festen Form und nur für eine Person dieses Ladens.
    function validSchedule(id, d) {
      return d.keys().hasOnly(['shopId', 'staffId', 'day', 'slots', 'updatedAt'])
        && d.day is string && d.slots is map && id == d.staffId + '_' + d.day
        && staffInShop(d.staffId, d.shopId);
    }

    match /schedules/{id} {
      allow read: if true;
      allow create: if validSchedule(id, request.resource.data);
      allow update: if validSchedule(id, request.resource.data)
        && request.resource.data.shopId == resource.data.shopId && request.resource.data.staffId == resource.data.staffId;
      allow delete: if ownsShop(resource.data.shopId);
    }

    // Tagesnummern je Laden (shop_days/{shopId}_{Tag}): jede gezogene Nummer hängt genau eine an, keine fällt weg
    function validShopDay(id, d) {
      return d.keys().hasOnly(['shopId', 'day', 'codes', 'updatedAt'])
        && d.day is string && d.codes is list && id == d.shopId + '_' + d.day
        && exists(docPath('shops', d.shopId));
    }

    match /shop_days/{id} {
      allow read: if true;
      allow create: if validShopDay(id, request.resource.data) && request.resource.data.codes.size() == 1;
      allow update: if validShopDay(id, request.resource.data) && request.resource.data.shopId == resource.data.shopId
        && request.resource.data.codes.hasAll(resource.data.codes)
        && request.resource.data.codes.size() == resource.data.codes.size() + 1;
      allow delete: if ownsShop(resource.data.shopId);
    }

    // ------------------------------------------------------------------------------------------------------------
    // Personen, Leistungen, Pausen: lesen alle (freie Plätze), pflegen der Inhaber. Die Verbindung einer Person mit
    // einem Konto (userId) und die Einladung setzt das Backend; der Inhaber nur sich selbst (Assistent, Inhaber im
    // Team). Die Person selbst ändert nur ihre Arbeitszeiten (Mein Tag).
    // ------------------------------------------------------------------------------------------------------------
    function inviteFields() {
      return ['inviteTokenHash', 'inviteExpires', 'inviteCreatedAt', 'inviteEmailTo', 'inviteEmailSentAt', 'inviteAcceptedAt'];
    }

    match /staff/{id} {
      allow read: if true;
      allow create: if ownsShop(request.resource.data.shopId)
        && request.resource.data.get('userId', '') in ['', request.auth.uid]
        && !request.resource.data.keys().hasAny(inviteFields());
      allow update: if (ownsShop(resource.data.shopId)
            && !changed().hasAny(['shopId'].concat(inviteFields()))
            && (!changed().hasAny(['userId']) || request.resource.data.userId == request.auth.uid))
        || (signedIn() && resource.data.get('userId', '') == request.auth.uid
            && changed().hasOnly(['workingHours', 'updatedAt']));
      allow delete: if ownsShop(resource.data.shopId);
    }

    match /services/{id} {
      allow read: if true;
      allow create: if ownsShop(request.resource.data.shopId);
      allow update: if ownsShop(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId;
      allow delete: if ownsShop(resource.data.shopId);
    }

    match /breaks/{id} {
      allow read: if true;
      allow create: if ownsShop(request.resource.data.shopId)
        && staffInShop(request.resource.data.staffId, request.resource.data.shopId);
      allow update: if ownsShop(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId
        && staffInShop(request.resource.data.staffId, request.resource.data.shopId);
      allow delete: if ownsShop(resource.data.shopId);
    }

    match /recurring-breaks/{id} {
      allow read: if true;
      allow create: if ownsShop(request.resource.data.shopId)
        && staffInShop(request.resource.data.staffId, request.resource.data.shopId);
      allow update: if ownsShop(resource.data.shopId) && request.resource.data.shopId == resource.data.shopId
        && staffInShop(request.resource.data.staffId, request.resource.data.shopId);
      allow delete: if ownsShop(resource.data.shopId);
    }

    // ------------------------------------------------------------------------------------------------------------
    // Kundenliste des Ladens: nur Inhaber und Team. Anlegen ohne Konto-Verbindung; verbinden, Link und Löschen
    // macht das Backend (/routes/customer-activation, /routes/datenschutz).
    // ------------------------------------------------------------------------------------------------------------
    match /customers/{id} {
      allow read: if isTeam(resource.data.shopId);
      allow create: if isTeam(request.resource.data.shopId)
        && request.resource.data.get('isActive', false) == false
        && !request.resource.data.keys().hasAny(['userId', 'activationToken', 'activationTokenHash', 'activationExpires']);
      allow delete: if ownsShop(resource.data.shopId);
    }

    // Profil eines Kontos: nur das eigene. Die Rolle steuert nur, was die App zeigt; Rechte hängen am Laden.
    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'customer') in ['customer', 'shopOwner', 'employee'];
    }

    // Angebote „Früher dran“: schreibt das Backend; lesen darf das eigene Konto, aufräumen auch der Laden (Testskripte)
    match /earlier_slot_notifications/{id} {
      allow read, delete: if signedIn()
        && (resource.data.get('userId', '') == request.auth.uid || ownsShop(resource.data.get('shopId', '')));
    }

    // Alte Warteschlange: die App fragt beim Nummer ziehen nur die eigenen Einträge ab und schreibt sie nicht mehr
    match /queue/{id} {
      allow read: if signedIn() && resource.data.get('customerId', '') == request.auth.uid;
    }

    // Keine Regel, also für den Browser zu – nur das Backend:
    //   meta                 Zähler der Gründerplätze (meta/gruender). Wer ihn zurücksetzt, bekäme Gründerpreise.
    //   push_subscriptions   Push-Adressen der Geräte (anmelden über /routes/push)
    //   staff-invitations    alt; Einladungen stehen gehasht am staff-Eintrag
    //   verzeichnis          Salon-Verzeichnis (/friseur/…); Seiten und Karte liefert das Backend
    //   und jede Sammlung, die hier nicht steht.
  }
}
