rules_version = '2';

// Firestore-Sicherheitsregeln für Dranzeit (Firebase-Projekt qmedata-7c79e).
// Fassung: 2026-11-04 (bei jeder Änderung neu setzen; daran erkennt der Block in deploy/README.md, was eingespielt ist)
//
// Eingespielt wird von Hand in der Firebase-Konsole: Anleitung und Rücknahme in deploy/README.md,
// Abschnitt „Firestore-Regeln“. Geprüft im Emulator: dev/regeln (npm test), läuft auch auf GitHub bei jedem Push.
//
// Seit Stufe 2 von requirements/eigene-datenbank.md liest und schreibt der Browser nichts mehr selbst in Firestore:
// Alles geht über das Backend (/routes/live, /routes/team, /routes/konto, /routes/nummer …). Das Backend arbeitet mit
// dem Admin SDK (Dienstkonto) und ist von diesen Regeln nicht betroffen. Für den Browser – mit oder ohne Anmeldung,
// auch mit dem öffentlichen Web-Schlüssel aus einem Testskript – ist deshalb alles zu.
//
// Wer was darf, steht jetzt im Backend (Rechte wie bisher hier: app/apis/firebase_utils.py require_shop_member,
// require_shop_of_owner; app/libs/team_laden.py, laeden.py, pausen.py, team_termine.py).
// Die letzte Fassung mit Zugriff aus dem Browser (2026-10-29) steht in der Git-Geschichte dieser Datei.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
