# Copy to .env next to docker-compose.yml and adjust.

# Public hostname of the test deployment. Its DNS A record must point to the
# server; Caddy then fetches a Let's Encrypt certificate on first start.
DOMAIN=test.example.com

# Firebase project whose ID tokens the backend accepts
FIREBASE_PROJECT_ID=qmedata-7c79e

# The Firebase service account key is not configured here: place the JSON file
# at secrets/firebase-service-account.json
