# Vorlage für den Q-ME-Block. setup-server.sh setzt __DOMAIN__, __PORT__ und
# __WEB_ROOT__ ein und hängt den Block an /etc/caddy/Caddyfile an.
#
# Die Caddyfile auf dem Server enthält auch die anderen Projekte (Spielmacherei,
# mamie, …) und ist dort die Wahrheit. Diese Vorlage nie über sie kopieren.
# Die Adresse steht als Klartext im Block, nicht als {$VARIABLE}: Ohne die
# Variable würde der Block als globaler Optionsblock gelesen.

__DOMAIN__ {
	encode zstd gzip

	# API an das Backend (uvicorn, nur lokal erreichbar)
	handle /routes/* {
		reverse_proxy 127.0.0.1:__PORT__
	}

	# Bausteine der React-App: Name enthält den Inhalt-Hash, also ewig gültig. Fehlt einer
	# (Seite vor dem Ausrollen geöffnet), ehrlich 404 statt index.html – sonst merkt sich der
	# Browser die HTML-Seite für ein Jahr als Skript.
	handle /assets/* {
		root * __WEB_ROOT__
		@vorhanden file
		header @vorhanden Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Alles andere ist die gebaute React-App. index.html immer nachfragen, damit nach dem
	# Ausrollen sofort die neuen Bausteine geladen werden.
	handle {
		root * __WEB_ROOT__
		header Cache-Control "no-cache"
		# /preise → preise.html (eigener Titel und Canonical), sonst app.html (frontend/vite.config.ts, seitenKoepfe)
		try_files {path} {path}.html /app.html /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/q-me.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}
