rules_version = '2';

// Speicher-Regeln (Firebase Storage) für Dranzeit, Bucket qmedata-7c79e.firebasestorage.app.
// Fassung: 2026-11-04 (bei jeder Änderung neu setzen; daran erkennt der Block in deploy/README.md, was eingespielt ist)
//
// Eingespielt wird von Hand in der Firebase-Konsole: Anleitung und Rücknahme in deploy/README.md, Abschnitt
// „Speicher-Regeln“. Geprüft im Emulator: dev/regeln (npm test), läuft auch auf GitHub bei jedem Push.
//
// Seit Stufe 2 von requirements/eigene-datenbank.md lädt die App neue Logos und Fotos zum eigenen Server hoch
// (backend/app/libs/laeden.py, /var/lib/q-me/dateien). Hier liegen nur noch ältere Bilder:
//  - shop-logos/{shopId}/…            Logo des Ladens
//  - staff-profile-images/{shopId}/…  Fotos der Personen
// Angezeigt werden sie über die Download-Adresse, die in Firestore steht; die gilt auch ohne diese Regeln. Ansehen
// bleibt offen, bis die Bilder in Stufe 5 umgezogen sind. Hochladen, Ersetzen, Löschen und Auflisten sind zu.
service firebase.storage {
  match /b/{bucket}/o {
    match /shop-logos/{shopId}/{file} {
      allow get: if true;
    }

    match /staff-profile-images/{shopId}/{file} {
      allow get: if true;
    }
  }
}
